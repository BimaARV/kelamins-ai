# KELA AI - environment template (copy to .env and fill)

APP_ENV=development

# --- Database (MariaDB 12) ---
# Host-side administration can connect through port 2407.
# Service-to-service uses docker hostname: mariadb
DATABASE_URL=mysql+asyncmy://kela:change-me@mariadb:3306/kela
MARIADB_DATABASE=kela
MARIADB_USER=kela
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# --- Collectors ---
# Authoritative earthquake feed (BMKG). Facts always come from this feed, never from AI.
BMKG_FEED_URL=https://data.bmkg.go.id/DataMKG/TEWS/autogempa.json
NEWS_POLL_INTERVAL_SECONDS=300
EARTHQUAKE_POLL_INTERVAL_SECONDS=120
NETWORK_POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=20

# --- BMKG Weather (Jakarta-Depok) ---
# Official BMKG weather API. Facts always come from BMKG, never from AI.
# Requires a browser-like User-Agent (built into the collector).
BMKG_WEATHER_ENDPOINT=https://api.bmkg.go.id/publik/prakiraan-cuaca
WEATHER_POLL_INTERVAL_SECONDS=1800
# Location resolver index (ships with the image). Used by /weather/query for
# free-text lookups (any adm4 area in Indonesia).
WEATHER_LOCATION_INDEX_PATH=data/kemendagri_adm.csv
# adm4 = Kemendagri village code (SK 100.1.1-6117/2022). Example watchlist:
# Jakarta + Depok Cimanggis. On-demand lookups (e.g. /weather/query?q=Tapos)
# do not need to be listed here.
WEATHER_LOCATIONS=[{"name":"Jakarta Pusat - Gambir","adm4":"31.71.01.1001"},{"name":"Depok - Cimanggis (Harjamukti)","adm4":"32.76.02.1007"}]

# --- Event Intelligence (Phase 2) ---
EVENT_POLL_INTERVAL_SECONDS=60
EVENT_SIMILARITY_THRESHOLD=0.45

# Initial news sources (JSON array). Only feeds that pass URL validation are used.
# Example:
# NEWS_SOURCE_FIXTURES=[{"name":"Antara","country":"ID","language":"id","source_type":"rss","base_url":"https://www.antaranews.com","feed_url":"https://www.antaranews.com/rss/terkini"}]
NEWS_SOURCE_FIXTURES=[]
# Tech/sport source filters for /news-tech and /news-sport (JSON array, matched
# against the source name). Leave empty for default behavior.
# NEWS_TECH_SOURCE_KEYWORDS=["teknologi","tekno","tech","techno"]
# NEWS_SPORT_SOURCE_KEYWORDS=["olahraga","sport","sepakbola","f1","motogp","bola"]
NEWS_SPORT_SOURCE_KEYWORDS=["olahraga","sport","sepakbola","f1","motogp","bola"]

# News recency: articles older than this many hours are never stored or displayed.
# Cleans stale feed backlog (e.g. Antara Olahraga 2025 items from 2026-09). 0 = no limit.
NEWS_MAX_AGE_HOURS=72
# AI news briefing for OOT discussion: keyword-match recent articles to ground answers.
NEWS_BRIEFING_MATCH_LIMIT=5
NEWS_BRIEFING_DESC_CHARS=300

# Seed network targets (JSON array) when the table is empty.
# target_type: ping | tcp | http | dns | snmp
# Chat-driven monitoring (/monitor <ip|domain>) creates ping targets on demand.
# NETWORK_TARGET_FIXTURES=[{"name":"Router","target_type":"ping","target":"192.168.1.1","interval_seconds":60,"timeout_seconds":5,"enabled":true}]

# --- Chat-driven network monitoring (Phase 6) ---
# Targets added via /monitor get alert on real up<->down flips, sent directly
# to TELEGRAM_CHAT_ID (not through the Alert Engine). Redis keys hold the
# opt-in list and last-known status.
NETWORK_MONITOR_STATE_TTL_SECONDS=2592000
NETWORK_MONITOR_IDS_TTL_SECONDS=31536000
# Pending-name prompt TTL: how long the "Mau dikasih nama?" question waits for a reply (seconds).
MONITOR_NAME_PROMPT_TTL_SECONDS=900
# Host executor: allowed roots (JSON array) for file ops via /host-root.
HOSTCMD_ALLOWED_ROOTS=["/home","/tmp","/var/log"]
# Free-text "jalanin <cmd>" fallback: when the first word is a real host binary
# (ls/cat/git/ps...), run it via chroot'd host shell. Disable for strict mode.
HOSTCMD_ENABLE_SHELL=true
# Optional blocklist overrides the default destructive-command filter
# (reboot/shutdown/mkfs/dd/rm -rf / ...). Leave empty to use the built-in default.
HOSTCMD_BLOCKED_RE=
# Output cap (chars) for host shell / command results.
HOSTCMD_OUTPUT_MAX_CHARS=3500

# --- KELA AI Gateway (Phase 3) ---
# All AI traffic flows through app.kela_ai.gateway - never direct HTTP to Ollama.
# Multiple keys are supported with automatic failover. Keys live ONLY here (or
# Docker secrets / Secret Manager), never plaintext inside MariaDB.
#
# MODEL POOL (optional): priority-ordered JSON list of provider models. When set,
# the gateway tries pool 1 first and only fails over to the next pool when pool 1
# is fully exhausted (2+ models => failover runs). base_url/model are optional and
# fall back to AI_*/OLLAMA_* below. Leave AI_MODELS empty for a single model.
#   providers: ollama | openai | gemini | claude  (gemini/claude via OpenAI-compatible endpoint)
#   AI_MODELS=[{"provider":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","model":"gemini-2.0-flash"},{"provider":"openai","base_url":"https://api.openai.com/v1","model":"gpt-4o"}]
AI_MODELS=[]
AI_PROVIDER=ollama
AI_BASE_URL=
AI_MODEL=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:cloud
# API keys are scanned from the environment dynamically - ANY number of keys works,
# per provider prefix + a shared LLM_ pool. Key N+1 is just another line, no code change:
#   OLLAMA_API_KEY_1=      # Ollama keys (also used when keys are not provider-specific)
#   OPENAI_API_KEY_1=      # OpenAI keys
#   GEMINI_API_KEY_1=      # Google Gemini keys
#   ANTHROPIC_API_KEY_1=   # Anthropic Claude keys
#   LLM_API_KEY_1=         # shared pool, usable by every model
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=
# AI worker cadence and safety limits. Without any configured key the AI worker
# skips processing entirely (graceful degradation) - collectors keep running.
AI_POLL_INTERVAL_SECONDS=60
AI_MAX_EVENTS_PER_CYCLE=5
AI_MAX_TOKENS=800
AI_CHAT_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=120
AI_RATE_LIMIT_PER_MINUTE=30
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SECONDS=60
AI_KEY_COOLDOWN_SECONDS=60

# --- Jarvis memory (Phase 6 free-text: "inget/catat ...") ---
# Memories are stored in the DB (memories table) and re-injected into the AI
# system prompt each turn. Oldest rows are pruned past MEMORY_MAX_ITEMS.
MEMORY_MAX_ITEMS=200
MEMORY_RECALL_LIMIT=10

# --- On-demand web scrape from free text ("scrape https://...") ---
# SSRF-guarded: only public routable hosts are fetched.
WEB_SCRAPE_MAX_BYTES=524288
WEB_SCRAPE_TEXT_CHARS=1800
WEB_SCRAPE_MAX_LINKS=6

# --- Telegram interactive bot (Phase 6) ---
# Free-text chat keeps a short per-chat conversation history in Redis so the AI
# can follow up on previous turns.
TELEGRAM_POLL_INTERVAL_SECONDS=2.0
TELEGRAM_CHAT_CONTEXT_LIMIT=8
TELEGRAM_NEWS_PUSH_INTERVAL_SECONDS=10800
TELEGRAM_NEWS_PUSH_COUNT=3
TELEGRAM_DIGEST_HOUR=6
# Cron/reminder checker cadence (free-text: "ingetin minum air jam 8 malam").
CRON_POLL_INTERVAL_SECONDS=15

# --- Alert channels (Phase 4/6) ---
# Leave tokens blank to run alert engine in dry-run: alerts + messages are still
# recorded, deliveries are marked 'skipped' (graceful).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Alert Engine (Phase 4) ---
ALERT_POLL_INTERVAL_SECONDS=30
ALERT_MAX_EVENTS_PER_CYCLE=10
ALERT_UPDATE_MIN_NEW_SOURCES=2
ALERT_UPDATE_MIN_NEW_ARTICLES=5
ALERT_UPDATE_COOLDOWN_SECONDS=900
ALERT_EARTHQUAKE_SIGNIFICANT_MAGNITUDE=5.0
ALERT_EARTHQUAKE_HIGH_MAGNITUDE=4.0

# --- Logging ---
LOG_LEVEL=INFO